# Copy this file to .env and fill in real values.
# .env is git-ignored - never commit real keys.

# ============================================================================
# DECISION LAYER (which agent handles a request)
# ============================================================================
# laya = real Laya Decision AI (pip install laya) | baseline | adaptive
DECISION_LAYER=laya
# Laya checkpoint (Hugging Face repo id).
LAYA_CHECKPOINT=convaiinnovations/laya
# Preload the checkpoint at startup instead of on first request.
LAYA_PRELOAD=false

# ============================================================================
# MODEL SELECTION (which model runs, once an agent is chosen)
# ============================================================================
# efficient = pick the lightest model that meets the task's complexity tier
#             (downgrades simple work, upgrades expert work)
# pinned    = keep the configured model whenever it is sufficient (upgrade only)
MODEL_SELECTION=efficient

# ============================================================================
# ACTIVE PROVIDER (which model answers, once an agent is chosen)
# ============================================================================
# Which provider the agents use by default: gemini | openrouter | groq
# Per-agent override is also possible, e.g. THREE_D_MODEL_PROVIDER=openrouter
AGENTROUTE_PROVIDER=gemini

# ============================================================================
# GEMINI (Step 5 default provider)
# ============================================================================
# Get a key from https://aistudio.google.com/apikey then paste it here.
GEMINI_API_KEY=

# The model every agent uses by default. NOTE: verify this against the models
# your key can access - change it here, never in Python.
GEMINI_MODEL=gemini-flash-latest

# Same-provider fallback used inside an agent if the primary model fails.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional per-agent Gemini overrides (all default to GEMINI_MODEL):
# GEMINI_GENERAL_MODEL=
# GEMINI_CODING_MODEL=
# GEMINI_REASONING_MODEL=
# GEMINI_RESEARCH_MODEL=
# GEMINI_THREE_D_MODEL=

# ============================================================================
# OPENROUTER (still supported - set AGENTROUTE_PROVIDER=openrouter to use)
# ============================================================================
OPENROUTER_API_KEY=
OPENROUTER_GENERAL_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_CODING_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_REASONING_MODEL=nvidia/nemotron-3-ultra:free
OPENROUTER_RESEARCH_MODEL=thinkingmachines/inkling:free
OPENROUTER_3D_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_REASONING_FALLBACK_MODEL=nvidia/nemotron-3-super:free
OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
# Optional OpenRouter ranking headers.
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=AgentRoute

# ============================================================================
# NVIDIA NIM (OpenAI-compatible: https://integrate.api.nvidia.com/v1)
# ============================================================================
# Key from https://build.nvidia.com/ (starts with nvapi-).
NVIDIA_API_KEY=
# Only needed if you pin an agent to NVIDIA via AGENTROUTE_PROVIDER=nvidia;
# otherwise the model selector picks NVIDIA models from the registry.
NVIDIA_MODEL=

# ============================================================================
# GROQ (still supported - set AGENTROUTE_PROVIDER=groq to use)
# ============================================================================
GROQ_API_KEY=
GROQ_MODEL=

# ============================================================================
# TOOLS
# ============================================================================
# Blender execution is OFF by default and is NOT used in Step 5.
BLENDER_EXECUTION_ENABLED=false
# Absolute path to the Blender binary if it is not on your PATH, e.g.:
#   C:\Program Files\Blender Foundation\Blender 4.x\blender.exe
# BLENDER_PATH=

# Web search backend for RESEARCH_AGENT's WEB_SEARCH_TOOL (not yet implemented).
# SEARCH_API_KEY=
